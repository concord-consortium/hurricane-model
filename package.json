{
  "name": "hurricane-model",
  "version": "1.7.0",
  "description": "Concord Consortium Hurricane Model",
  "main": "index.js",
  "jest": {
    "testEnvironmentOptions": {
      "url": "https://hurricane-model.unexisting.url.com"
    },
    "setupFilesAfterEnv": [
      "jest-canvas-mock",
      "<rootDir>src/setupTests.js"
    ],
    "transform": {
      ".(ts|tsx|js)$": "ts-jest"
    },
    "testEnvironment": "jsdom",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/cypress/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(screenfull|d3-scale|d3-array|d3-color|d3-format|d3-interpolate|d3-time|d3-time-format|internmap|react-leaflet|@react-leaflet|@x0k)/)"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/utilities/test-utils.ts"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "common\\.scss$": "<rootDir>/__mocks__/common-scss-mock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "^pixi\\.js$": "<rootDir>/__mocks__/pixi.js.js"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "scripts": {
    "start": "webpack serve --hot",
    "build": "npm-run-all lint:build clean build:webpack",
    "build:webpack": "webpack --mode production --devtool false",
    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:build": "LINT_BUILD=1 eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "lint:unused": "tsc --noUnusedLocals --project .",
    "test": "jest",
    "test:all": "npm-run-all build test start",
    "test:coverage": "jest --coverage",
    "test:debug": "node --nolazy --inspect-brk ./node_modules/.bin/jest --runInBand --no-cache",
    "test:watch": "jest --watch",
    "test:coverage:watch": "jest --coverage --watchAll",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:full": "npm-run-all test test:cypress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concord-consortium/hurricane-model.git"
  },
  "author": "Concord Consortium",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/concord-consortium/hurricane-model/issues"
  },
  "homepage": "https://github.com/concord-consortium/hurricane-model#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-leaflet": "^3.0.0",
    "@types/seedrandom": "^3.0.8",
    "assert": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "cypress": "^15.16.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "html-webpack-plugin": "^5.6.7",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^3.0.3",
    "mercator-projection": "0.0.2",
    "mini-css-extract-plugin": "^2.10.2",
    "node-pre-gyp": "^0.17.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "process": "^0.11.10",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "script-loader": "^0.7.2",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "util": "^0.12.5",
    "wait-on": "^9.0.10",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@concord-consortium/lara-interactive-api": "^1.13.0",
    "@concord-consortium/log-monitor": "^1.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@react-leaflet/core": "^3.0.0",
    "@rjsf/core": "^6.5.3",
    "@rjsf/utils": "^6.5.3",
    "@rjsf/validator-ajv8": "^6.5.3",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/line-intersect": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "clsx": "^2.1.1",
    "d3-scale": "^3.3.0",
    "geolocation-utils": "1.2.6",
    "jquery": "^4.0.0",
    "kd-tree-javascript": "^1.0.3",
    "leaflet": "^1.9.4",
    "mobx": "^6.15.4",
    "mobx-react": "^9.2.2",
    "pixi.js": "^8.18.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "screenfull": "^6.0.2",
    "seedrandom": "^3.0.5",
    "shutterbug": "^1.5.0"
  }
}
