{
  "name": "hurricane-model",
  "version": "1.7.0",
  "description": "Concord Consortium Hurricane Model",
  "main": "index.js",
  "jest": {
    "testEnvironmentOptions": {
      "url": "https://hurricane-model.unexisting.url.com"
    },
    "setupFilesAfterEnv": [
      "jest-canvas-mock",
      "<rootDir>src/setupTests.js"
    ],
    "transform": {
      ".(ts|tsx|js)$": "ts-jest"
    },
    "testEnvironment": "jsdom",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/cypress/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(screenfull|d3-scale|d3-array|d3-color|d3-format|d3-interpolate|d3-time|d3-time-format|internmap)/)"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/utilities/test-utils.ts"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "scripts": {
    "start": "webpack-dev-server --hot",
    "build": "npm-run-all lint:build clean build:webpack",
    "build:webpack": "webpack --mode production --devtool false",
    "clean": "rimraf dist",
    "lint": "tslint -c tslint.json 'src/**/*.{ts,tsx}'",
    "lint:build": "tslint -c tslint-build.json 'src/**/*.{ts,tsx}'",
    "lint:fix": "tslint -c tslint-build.json --fix 'src/**/*.{ts,tsx}'",
    "lint:unused": "tsc --noUnusedLocals --project .",
    "test": "jest",
    "test:all": "npm-run-all build test start",
    "test:coverage": "jest --coverage",
    "test:debug": "node --nolazy --inspect-brk ./node_modules/.bin/jest --runInBand --no-cache",
    "test:watch": "jest --watch",
    "test:coverage:watch": "jest --coverage --watchAll",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:full": "npm-run-all test test:cypress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concord-consortium/hurricane-model.git"
  },
  "author": "Concord Consortium",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/concord-consortium/hurricane-model/issues"
  },
  "homepage": "https://github.com/concord-consortium/hurricane-model#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@svgr/webpack": "^5.5.0",
    "@types/enzyme": "^3.10.19",
    "@types/enzyme-adapter-react-16": "^1.0.9",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/pixi.js": "^4.8.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^16.14.17",
    "@types/react-dom": "^16.9.14",
    "@types/react-jsonschema-form": "^1.7.13",
    "@types/react-leaflet": "^2.8.2",
    "@types/seedrandom": "^3.0.8",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.3.0",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^5.1.2",
    "css-loader": "^5.2.7",
    "cypress": "^15.14.2",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "file-loader": "^4.3.0",
    "html-webpack-plugin": "^4.5.2",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.3.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "jest-fetch-mock": "^3.0.3",
    "mercator-projection": "0.0.2",
    "mini-css-extract-plugin": "^0.12.0",
    "node-pre-gyp": "^0.17.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.14",
    "postcss-loader": "^4.3.0",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "sass-loader": "^10.2.0",
    "script-loader": "^0.7.2",
    "style-loader": "^1.3.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^8.3.0",
    "ts-node": "^10.9.2",
    "tslint": "^5.20.1",
    "tslint-loader": "^3.5.4",
    "tslint-react": "^4.2.0",
    "typescript": "^4.9.5",
    "url-loader": "^2.3.0",
    "wait-on": "^9.0.5",
    "webpack": "^4.47.0",
    "webpack-cli": "3.3.12",
    "webpack-dev-server": "3.11.2"
  },
  "dependencies": {
    "@concord-consortium/lara-interactive-api": "^1.13.0",
    "@concord-consortium/log-monitor": "^1.0.0",
    "@material-ui/core": "4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@turf/helpers": "^7.3.5",
    "@turf/line-intersect": "^7.3.5",
    "d3-scale": "^4.0.2",
    "geolocation-utils": "1.2.6",
    "jquery": "^3.6.0",
    "kd-tree-javascript": "^1.0.3",
    "leaflet": "^1.9.4",
    "mobx": "^6.15.2",
    "mobx-react": "^9.2.1",
    "pixi.js": "^4.8.9",
    "pngjs": "^7.0.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-jsonschema-form": "^1.8.1",
    "react-leaflet": "^2.8.0",
    "react-leaflet-control": "^2.1.2",
    "screenfull": "^6.0.2",
    "seedrandom": "^3.0.5",
    "shutterbug": "^1.5.0"
  }
}
