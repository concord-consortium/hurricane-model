{
  "name": "hurricane-model",
  "version": "1.7.0",
  "description": "Concord Consortium Hurricane Model",
  "main": "index.js",
  "jest": {
    "testEnvironmentOptions": {
      "url": "https://hurricane-model.unexisting.url.com"
    },
    "setupFilesAfterEnv": [
      "jest-canvas-mock",
      "<rootDir>src/setupTests.js"
    ],
    "transform": {
      ".(ts|tsx|js)$": "ts-jest"
    },
    "testEnvironment": "jsdom",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/cypress/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(screenfull|d3-scale|d3-array|d3-color|d3-format|d3-interpolate|d3-time|d3-time-format|internmap)/)"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/utilities/test-utils.ts"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "^pixi\\.js$": "<rootDir>/__mocks__/pixi.js.js"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "scripts": {
    "start": "webpack serve --hot",
    "build": "npm-run-all lint:build clean build:webpack",
    "build:webpack": "webpack --mode production --devtool false",
    "clean": "rimraf dist",
    "lint": "tslint -c tslint.json 'src/**/*.{ts,tsx}'",
    "lint:build": "tslint -c tslint-build.json 'src/**/*.{ts,tsx}'",
    "lint:fix": "tslint -c tslint-build.json --fix 'src/**/*.{ts,tsx}'",
    "lint:unused": "tsc --noUnusedLocals --project .",
    "test": "jest",
    "test:all": "npm-run-all build test start",
    "test:coverage": "jest --coverage",
    "test:debug": "node --nolazy --inspect-brk ./node_modules/.bin/jest --runInBand --no-cache",
    "test:watch": "jest --watch",
    "test:coverage:watch": "jest --coverage --watchAll",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:full": "npm-run-all test test:cypress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concord-consortium/hurricane-model.git"
  },
  "author": "Concord Consortium",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/concord-consortium/hurricane-model/issues"
  },
  "homepage": "https://github.com/concord-consortium/hurricane-model#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^13.5.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^17.0.86",
    "@types/react-dom": "^17.0.26",
    "@types/react-leaflet": "^2.8.2",
    "@types/seedrandom": "^3.0.8",
    "assert": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "cypress": "^15.14.2",
    "html-webpack-plugin": "^5.6.7",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.4.1",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^3.0.3",
    "mercator-projection": "0.0.2",
    "mini-css-extract-plugin": "^2.10.2",
    "node-pre-gyp": "^0.17.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.14",
    "postcss-loader": "^8.2.1",
    "process": "^0.11.10",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "script-loader": "^0.7.2",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tslint": "^5.20.1",
    "tslint-react": "^4.2.0",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "wait-on": "^9.0.5",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@concord-consortium/lara-interactive-api": "^1.13.0",
    "@concord-consortium/log-monitor": "^1.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@turf/helpers": "^7.3.5",
    "@turf/line-intersect": "^7.3.5",
    "d3-scale": "^4.0.2",
    "geolocation-utils": "1.2.6",
    "jquery": "^4.0.0",
    "kd-tree-javascript": "^1.0.3",
    "leaflet": "^1.9.4",
    "mobx": "^6.15.3",
    "mobx-react": "^9.2.1",
    "pixi.js": "^8.18.1",
    "pngjs": "^7.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-leaflet": "^2.8.0",
    "react-leaflet-control": "^2.1.2",
    "screenfull": "^6.0.2",
    "seedrandom": "^3.0.5",
    "shutterbug": "^1.5.0"
  }
}
